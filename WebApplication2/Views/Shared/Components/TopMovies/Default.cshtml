@model IEnumerable<Day2.Models.Movie>

@* View Component View: Nhận dữ liệu từ TopMoviesViewComponent.InvokeAsync *@
<div class="card shadow-sm mb-4 border-primary">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            🎬 Danh Sách Phim (Được load bởi <strong>View Component</strong>)
        </h5>
        <span class="badge bg-light text-primary fw-bold">Tổng: @Model.Count() phim</span>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-warning mb-0">Không có phim nào phù hợp với bộ lọc!</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var movie in Model)
                {
                    @* Tái sử dụng Partial View _MovieCardPartial cho từng phần tử *@
                    <partial name="_MovieCardPartial" model="movie" />
                }
            </div>
        }
    </div>
</div>
